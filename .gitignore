# Root .gitignore for Zosh Trade (Full-Stack Spring Boot + React)

# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Production & Build outputs
dist/
frontend/dist/
target/
backend/target/
*.class

# Maven wrapper jar cache
.mvn/timing
backend/.mvn/timing

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Files
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# Editor & IDE caches
.idea/
*.iml
.settings/
.project
.classpath

# Local backups
*-backup*
