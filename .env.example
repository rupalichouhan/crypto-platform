# Zosh Trade - Environment Configuration Template
# Copy this file to .env (or configure in your deployment environment)

# Backend Configuration (Spring Boot)
SERVER_PORT=9229
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/yt_trading
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password
SPRING_JPA_SHOW_SQL=true

# Security & JWT
JWT_SECRET=your_jwt_secret_min_64_characters_recommended

# Payment Gateways (Optional for local browsing, required for wallet top-up)
STRIPE_API_KEY=your_stripe_api_key_here
RAZORPAY_API_KEY=your_razorpay_key_id_here
RAZORPAY_API_SECRET=your_razorpay_secret_here

# Frontend Configuration (Vite + React)
# VITE_API_BASE_URL=http://localhost:9229
