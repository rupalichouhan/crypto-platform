{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Spring Boot - TradingApplication",
            "request": "launch",
            "mainClass": "com.zosh.TradingApplication",
            "projectName": "trading",
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Vite Frontend - Chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        },
        {
            "type": "java",
            "name": "Current Java File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
